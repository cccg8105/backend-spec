{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UseCaseSpecification",
  "description": "Esquema formal para la validación de especificaciones de casos de uso funcionales (Etapa 1)",
  "type": "object",
  "required": [
    "id",
    "title",
    "domain",
    "actor",
    "status",
    "trigger",
    "process_diagram_mermaid",
    "inputs",
    "outputs",
    "business_rules"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^UC-[A-Z0-9]+-[0-9]{3,}$",
      "description": "Identificador único con formato UC-[DOMINIO]-[NUMERO] (ej. UC-AUTH-001)"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "domain": {
      "type": "string",
      "minLength": 2,
      "description": "Dominio de negocio al que pertenece el caso de uso (ej. auth, billing, orders)"
    },
    "actor": {
      "type": "string",
      "minLength": 2
    },
    "status": {
      "type": "string",
      "enum": ["Borrador", "Activo", "As-Is (Brownfield)", "Deprecado"]
    },
    "ocl_applied": {
      "type": "boolean"
    },
    "trigger": {
      "type": "string",
      "minLength": 3
    },
    "preconditions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "process_diagram_mermaid": {
      "type": "string",
      "minLength": 10,
      "description": "Bloque de diagrama de flujo o secuencia en sintaxis Mermaid"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "required"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "required": { "type": "boolean" },
          "validation": { "type": "string" }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "business_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^BR-[0-9]{2,}$" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "ocl_contract": { "type": "string" }
        }
      }
    },
    "side_effects": {
      "type": "object",
      "properties": {
        "database_changes": { "type": "array", "items": { "type": "string" } },
        "external_systems": { "type": "array", "items": { "type": "string" } },
        "domain_events": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
